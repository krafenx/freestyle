# Пример настроек сервера. Скопируйте в файл .env только если нужно что-то изменить:
# без этого файла платформа запускается со значениями ниже.

# Адрес и порт, на которых слушает сервер.
# 0.0.0.0 — принимать подключения снаружи (контейнеры, предпросмотр).
# Если перед приложением стоит Caddy или Nginx на этой же машине, укажите 127.0.0.1.
HOST=0.0.0.0
PORT=3000

# Где лежат база данных и загруженные пользователями файлы
DB_PATH=./data/overlay.db
UPLOADS_DIR=./data/uploads

# Каким промежуточным серверам верить насчёт адреса посетителя.
# loopback — только программе на этой же машине (обычная схема с Caddy/Nginx).
# От этого зависит и защита от подбора паролей: она считает попытки по адресу посетителя.
TRUST_PROXY=loopback

# Кто может создавать аккаунты.
# open   — любой посетитель (с ограничением числа попыток);
# closed — никто: страница регистрации сообщает, что регистрация закрыта.
#          Уже созданные аккаунты продолжают работать.
REGISTRATION=open

# Как браузер хранит вход.
# standard — обычная работа сайта. Менять не нужно.
# embedded — только для предпросмотра, когда сайт открыт внутри чужой страницы
#            (во фрейме) по https. Для настоящего сайта не использовать.
SESSION_COOKIE_MODE=standard
