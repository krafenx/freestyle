{
  "name": "vip-bot",
  "private": true,
  "type": "module",
  "description": "Учёт Twitch VIP на месяц: Telegram Serverless (tgcloud) + встроенная SQLite",
  "scripts": {
    "deploy": "tgcloud push",
    "status": "tgcloud status",
